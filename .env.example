# docker-compose.app.yml için örnek ortam değişkenleri. Kopyalayıp .env yapın (.env depoya girmez):  cp .env.example .env
# BU DEĞERLER YALNIZ YEREL GELİŞTİRME İÇİNDİR. Gerçek ortamda kendi gizli değerlerinizi üretin ve depoya koymayın.

# PostgreSQL (docker-compose.yml)
POSTGRES_DB=hospital
POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital_dev
POSTGRES_PORT=5432

# JWT imza anahtarı: en az 32 karakter. Üretmek için:  openssl rand -base64 48
JWT_SIGNING_KEY=local-dev-only-jwt-signing-key-change-me-0123456789

# Hassas veri (T.C. kimlik no) şifreleme anahtarı: Base64, tam 32 bayt. Üretmek için:  openssl rand -base64 32
# DİKKAT: Anahtar kaybolursa şifreli veri çözülemez; değişirse mevcut şifreli veri okunamaz. Yedekleyin.
DATA_PROTECTION_KEY=bG9jYWwtZGV2LW9ubHktZGF0YS1rZXktMDAwMDAwMDE=

# İlk süper yönetici (ilk açılışta oluşur)
SEED_ADMIN_EMAIL=admin@hastane.local
SEED_ADMIN_PASSWORD=Admin12345x

# Örnek veri (bölüm/hizmet) ve örnek doktor: demo içindir; gerçek ortamda kapalı bırakın
SEED_SAMPLE_DATA=true
SEED_SAMPLE_DOCTOR_EMAIL=doktor@hastane.local
SEED_SAMPLE_DOCTOR_PASSWORD=Doktor12345x

# Port ve diğerleri
API_PORT=8080
AUTH_RATE_LIMIT=100
OPENAPI_ENABLED=true
CORS_ORIGIN=http://localhost:5173
