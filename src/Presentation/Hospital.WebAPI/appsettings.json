{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "HastaneSistemi",
    "Audience": "HastaneSistemi.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Appointment": {
    "SlotGridMinutes": 15,
    "MinLeadMinutes": 60,
    "MaxBookingHorizonDays": 60,
    "CancellationDeadlineHours": 2
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "Seed": {
    "OrganizationName": "Hastane Grubu",
    "HospitalName": "Merkez Şube",
    "TimeZone": "Europe/Istanbul",
    "SampleData": false
  }
}
