{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "Seed": {
    "OrganizationName": "Hastane Grubu",
    "HospitalName": "Merkez Şube",
    "TimeZone": "Europe/Istanbul",
    "SampleData": false
  }
}
