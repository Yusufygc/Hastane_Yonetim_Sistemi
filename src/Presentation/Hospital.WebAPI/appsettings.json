{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "HastaneSistemi",
    "Audience": "HastaneSistemi.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Security": {
    "DataProtection": {
      "Key": ""
    }
  },
  "Auth": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Appointment": {
    "SlotGridMinutes": 15,
    "MinLeadMinutes": 60,
    "MaxBookingHorizonDays": 60,
    "CancellationDeadlineHours": 2,
    "PendingExpiry": {
      "Enabled": true,
      "Hours": 48,
      "PollSeconds": 300,
      "BatchSize": 50
    }
  },
  "Email": {
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Security": "None",
      "FromAddress": "noreply@hastane.local",
      "FromName": "Hastane Randevu Sistemi"
    },
    "Outbox": {
      "Enabled": true,
      "PollSeconds": 5,
      "BatchPerCycle": 20,
      "MaxAttempts": 5,
      "BaseDelaySeconds": 30,
      "MaxDelaySeconds": 3600
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "Seed": {
    "OrganizationName": "Hastane Grubu",
    "HospitalName": "Merkez Şube",
    "TimeZone": "Europe/Istanbul",
    "SampleData": false
  }
}
